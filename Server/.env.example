# HTTP port for the Express server (defaults to 5000 when unset).
PORT=5000
# MongoDB connection string.
MONGODB_URI=
# Secret used to sign and verify JWTs.
JWT_SECRET=
# Cloudinary credentials used for uploaded media.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Browser origin allowed by CORS (defaults to http://localhost:5173 when unset).
FRONTEND_URL=http://localhost:5173
# Base URL for the FastAPI AI service (defaults to http://127.0.0.1:8000 when unset).
AI_SERVICE_URL=http://127.0.0.1:8000
# Shared secret sent to the AI service in the X-AI-Service-Key header.
AI_SERVICE_API_KEY=
